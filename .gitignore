/.vscode
/lists

# Secrets — never commit
.env
.env.*
!.env.example

# Linear sync scratch output
scripts/_linear_state.json
scripts/_linear_state.md
scripts/_*_out.txt

# Tauri build artifacts — anchored to the repo root so that documentation
# directories such as docs/release/ are NOT accidentally ignored.
src-tauri/target/
src-tauri/gen/
/dist/
node_modules/
/release/
/Data/

# Generated benchmark datasets (can exceed 100k tasks; regenerate deterministically)
/data/benchmarks/
/benchmarks-out/

# Runtime asset and workspace metadata directories
.assets/
.moderntodo/

# Isolated cargo target dir used for authoritative verification runs
src-tauri/target-final/
